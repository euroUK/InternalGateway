{
  "Gateway": {
    "DslPath": "../dsl",
    "EnvelopeSecret": "poc-envelope-secret-min-32-chars!!",
    "CorsAllowedOrigins": "http://localhost:3000",
    "DepositOfferServiceUrl": "http://localhost:8090",
    "KafkaBootstrapServers": "localhost:9092",
    "ListenerBindings": [ "deposit-processor-offer-lifecycle" ],
    "Envelope": {
      "Issuer": "internal-gateway",
      "TtlSeconds": 30,
      "BusinessControlEvidenceId": "poc-stub-passed"
    },
    "Dedup": {
      "MaximumSize": 10000,
      "DefaultTtl": "7.00:00:00"
    },
    "Observability": {
      "TraceBufferSize": 500,
      "TopRoutesLimit": 10
    },
    "Resilience": {
      "BackoffBaseMs": 100,
      "BackoffJitterMs": 50
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
